# =============================================================================
# AI English Tutor - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!
# =============================================================================

# --- DATABASE ---
APP_DB_URL=jdbc:mysql://localhost:3306/ai_english_exam?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
APP_DB_USERNAME=root
APP_DB_PASSWORD=change_me
APP_DB_POOL_MAX=20
APP_DB_POOL_MIN_IDLE=5
APP_DB_POOL_TIMEOUT=10000
APP_DB_POOL_KEEPALIVE=180000
APP_DB_VALIDATION_TIMEOUT=2000
APP_JPA_BATCH_SIZE=50
APP_TX_TIMEOUT_SECONDS=30

# --- JWT AUTH ---
# Generate with: openssl rand -base64 64 (required for docker compose backend)
APP_JWT_SECRET=replace_with_a_long_random_secret
APP_JWT_EXPIRATION=3600000

# --- REDIS (required for docker compose prod rate limiting) ---
APP_REDIS_PASSWORD=replace_with_redis_password

# --- CACHE ---
APP_CACHE_TYPE=redis
APP_CACHE_ROLES_TTL_SECONDS=3600
APP_CACHE_TEACHERS_TTL_SECONDS=300

# --- LEARNING SERVICE ---
LEARNING_DB_URL=jdbc:mysql://localhost:3306/ai_english_learning?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LEARNING_DB_USERNAME=root
LEARNING_DB_PASSWORD=change_me
LEARNING_CACHE_TYPE=redis
LEARNING_REDIS_PASSWORD=replace_with_redis_password
LEARNING_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

# --- SERVER ---
APP_SERVER_PORT=8080
APP_TOMCAT_THREADS=50
APP_TOMCAT_MIN_THREADS=10
APP_TOMCAT_ACCEPT=100
APP_TOMCAT_MAX_CONN=200

# --- FILE UPLOAD ---
APP_UPLOAD_MAX_SIZE=10MB

# --- AI: DeepSeek (required for scoring) ---
APP_DEEPSEEK_API_KEY=replace_with_deepseek_api_key
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_DEEPSEEK_MODEL=deepseek-chat

# --- AI: Whisper Fallback (optional) ---
APP_WHISPER_API_KEY=
APP_WHISPER_BASE_URL=https://api.openai.com/v1

# --- AI: OCR.space Fallback (optional) ---
APP_OCR_SPACE_API_KEY=

# --- AI: Local Service ---
APP_AI_LOCAL_URL=http://127.0.0.1:8002
APP_AI_LOCAL_OCR_URL=
APP_AI_LOCAL_TTS_URL=
APP_AI_LOCAL_TRANSCRIBE_URL=
APP_AI_CONNECT_TIMEOUT=15
APP_AI_REQUEST_TIMEOUT=120
APP_AI_TOTAL_TIMEOUT=170

# --- AI: Async Thread Pool ---
APP_AI_ASYNC_CORE=5
APP_AI_ASYNC_MAX=20
APP_AI_ASYNC_QUEUE=100

# --- FFMPEG ---
APP_FFMPEG_BINARY=ffmpeg
APP_FFPROBE_BINARY=ffprobe

# --- SECURITY ---
APP_BCRYPT_STRENGTH=12
APP_JPA_DDL_AUTO=validate
APP_FLYWAY_ENABLED=true
APP_FLYWAY_REPAIR=false

# --- LOGGING ---
APP_LOG_LEVEL=INFO
APP_SECURITY_LOG_LEVEL=WARN

# --- OBSERVABILITY ---
APP_MANAGEMENT_EXPOSURE=health,info,metrics,prometheus
