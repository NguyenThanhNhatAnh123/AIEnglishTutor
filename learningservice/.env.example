# =============================================================================
# Learning Service - Environment Variables Template
# Copy values into backend/.env for docker compose, or into a local .env runner.
# =============================================================================

# --- DATABASE ---
LEARNING_DB_URL=jdbc:mysql://localhost:3306/ai_english_learning?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LEARNING_DB_USERNAME=root
LEARNING_DB_PASSWORD=change_me
LEARNING_DB_POOL_MAX=20
LEARNING_DB_POOL_MIN_IDLE=5
LEARNING_DB_POOL_TIMEOUT=10000
LEARNING_DB_POOL_KEEPALIVE=180000
LEARNING_DB_VALIDATION_TIMEOUT=2000
LEARNING_JPA_BATCH_SIZE=50
LEARNING_TX_TIMEOUT_SECONDS=15

# --- JWT AUTH ---
# Must match APP_JWT_SECRET used by backend because students log in there.
APP_JWT_SECRET=replace_with_same_backend_jwt_secret

# --- REDIS / CACHE ---
LEARNING_CACHE_TYPE=redis
LEARNING_REDIS_HOST=localhost
LEARNING_REDIS_PORT=6379
LEARNING_REDIS_PASSWORD=replace_with_redis_password
LEARNING_REDIS_TIMEOUT=1s
LEARNING_REDIS_HEALTH_ENABLED=true

# --- SERVER / CORS ---
LEARNING_SERVER_PORT=8081
LEARNING_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

# --- SECURITY / DB MIGRATION ---
LEARNING_JPA_DDL_AUTO=validate
LEARNING_FLYWAY_ENABLED=true
LEARNING_FLYWAY_REPAIR=false
